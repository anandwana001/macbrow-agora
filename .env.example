# Copy to .env.local. Agora credentials belong in .env.agora (see agora/.env.example).
# Required for Mac actions: https://console.typesafe.ai
TYPESAFE_API_KEY=

# Optional Chrome profile selection.
# MACBROW_CHROME_PROFILE_EMAIL=you@example.com
# MACBROW_CHROME_PROFILE_DIR=Profile 1
# MACBROW_CHROME_HOME=

# Optional extended experiments; not needed for the standard Agora demo.
# Autonomous browser tasks and writing new tools require a local model in LM Studio.
# MACBROW_AGORA_EXTENDED=1
# MACBROW_LOCAL_MODEL=your-loaded-model-id
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_API_KEY=lm-studio
# MACBROW_CODEGEN_MODEL=your-loaded-model-id
# MACBROW_REASONING_EFFORT=none  # only if your model supports this setting
# MACBROW_LEARN=0               # browser experiments without learning new tools
# MACBROW_BROWSER_BUDGET_S=90
