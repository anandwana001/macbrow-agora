# Save as .env.agora in the repository root. Never commit credentials.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# An HTTPS tunnel pointing ONLY at http://127.0.0.1:8101, with /mcp appended.
MACBROW_MCP_URL=https://your-tunnel.example/mcp

# In .env.local: TYPESAFE_API_KEY=...
# Default: predefined Mac tools, no extra model/provider keys required.
# MACBROW_AGORA_EXTENDED=0
# Extended browser/learning features need the original app's model configuration;
# see .env.example at the repository root before enabling them.
